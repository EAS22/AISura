{
  "identifier": "default",
  "description": "Default capabilities for AISura",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-app-write",
    "fs:allow-app-read",
    "fs:allow-app-meta",
    "fs:scope-app-local",
    "fs:scope-app",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "process:default"
  ]
}
