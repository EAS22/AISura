{
  "identifier": "default",
  "description": "Default capabilities for AISura",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:scope-appconfig-recursive",
    "fs:allow-appconfig-read-recursive",
    "fs:allow-appconfig-write-recursive",
    "fs:allow-appconfig-meta-recursive",
    "fs:read-all",
    "fs:write-all",
    "process:default"
  ]
}
